{
  "manifest_version": 3,
  "name": "Fiskalio – nova kartica",
  "short_name": "Fiskalio",
  "version": "1.0.0",
  "description": "Kalendar računa iz Fiskalija na svakoj novoj kartici.",
  "minimum_chrome_version": "115",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
